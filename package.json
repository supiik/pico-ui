{
  "name": "@supiik/pico-ui",
  "version": "0.2.0",
  "description": "Spoločné UI aquaria a admin aplikácií: komponenty shadcn-vue, DataTable, FormDialog, confirm, AppShell s ľavým menu, ikony aplikácií, spinner a téma.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./utils": "./src/utils.ts",
    "./ui/*": "./src/ui/*/index.ts",
    "./theme.css": "./src/theme.css",
    "./Spinner.vue": "./src/components/Spinner.vue",
    "./DataTable.vue": "./src/components/DataTable.vue",
    "./FormDialog.vue": "./src/components/FormDialog.vue",
    "./ConfirmHost.vue": "./src/components/ConfirmHost.vue",
    "./AppIcon.vue": "./src/components/AppIcon.vue",
    "./confirm": "./src/confirm.ts",
    "./icons": "./src/icons.ts",
    "./iconNames": {
      "types": "./src/iconNames.ts",
      "node": "./dist/iconNames.js",
      "default": "./src/iconNames.ts"
    },
    "./AppShell.vue": "./src/components/AppShell.vue",
    "./SidebarNav.vue": "./src/components/SidebarNav.vue",
    "./nav": "./src/nav.ts",
    "./portalNav": "./src/portalNav.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@lucide/vue": ">=1.0.0",
    "@vueuse/core": ">=13.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": ">=3.0.0",
    "tw-animate-css": ">=1.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@lucide/vue": {
      "optional": true
    },
    "@vueuse/core": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "reka-ui": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "tw-animate-css": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lucide/vue": "^1.81.0",
    "@types/node": "^26.6.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
